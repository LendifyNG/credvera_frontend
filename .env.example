# Business dashboard sign-in (/business/app) until the API checks codes and
# PINs. Copy to .env.local for a local copy, or set these in the hosting
# provider's environment settings. Never commit real values: this repo is public.

# The account's phone number, 10 digits without +234 or the leading 0.
VITE_BIZ_PHONE=
# SHA-256 (hex) of "credvera-biz-code:" + the six-digit code.
VITE_BIZ_CODE_SHA256=
# SHA-256 (hex) of "credvera-biz-pin:" + the four-digit PIN.
VITE_BIZ_PIN_SHA256=
