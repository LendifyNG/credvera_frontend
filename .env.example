# Where the business dashboard (/business/app) finds the Credvera API.
# Copy to .env.local for a local copy, or set in the host's environment settings.

# Local development: the dev server forwards /api to this backend, so the
# browser never talks to another port. Match the backend's PORT.
API_PROXY_TARGET=http://localhost:5000

# Deployed copies: the API's full URL, including the /api prefix. Leave unset
# locally to use the proxy above.
# VITE_API_URL=https://api.credvera.com/api
