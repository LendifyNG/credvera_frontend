{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/business-payments", "destination": "/business/payments", "permanent": true },
    { "source": "/cross-border", "destination": "/business/fx", "permanent": true },
    { "source": "/supplier-payments", "destination": "/business/suppliers", "permanent": true },
    { "source": "/study-abroad", "destination": "/", "permanent": true },
    { "source": "/pay-home", "destination": "/personal/abroad", "permanent": true }
  ],
  "rewrites": [
    { "source": "/business/app", "destination": "/shell.html" },
    { "source": "/business/app/:path*", "destination": "/shell.html" },
    { "source": "/pay/:path*", "destination": "/shell-pay.html" },
    { "source": "/c/:path*", "destination": "/shell-gift.html" },
    { "source": "/s/:path*", "destination": "/shell-pay.html" },
    { "source": "/verify", "destination": "/shell.html" },
    { "source": "/verify/:path*", "destination": "/shell.html" }
  ],
  "headers": [
    {
      "source": "/(business/app|business/app/.*|pay/.*|c/.*|s/.*|verify|verify/.*|shell.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
